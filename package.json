{
  "name": "vanta",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "VANTA: привычки, заметки, финансы, цели и прогресс с друзьями в Telegram",
  "engines": { "node": ">=24 <25" },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "bot:setup": "node --env-file-if-exists=.env scripts/setup-bot.mjs"
  },
  "dependencies": { "pg": "8.16.3" }
}
